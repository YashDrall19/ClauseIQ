DATABASE_URL=sqlite:///./storage/contracts.db
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
OCR_DPI=150
MAX_OCR_IMAGE_PIXELS=25000000
MAX_OCR_IMAGE_DIMENSION=6000
MIN_PDF_TEXT_CHARS=80
MIN_PAGE_TEXT_CHARS=40
# Choose one provider. Never put either key in frontend code.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENT_REQUESTS=2
# Character cap sent to the AI provider per request. Larger contracts are truncated safely.
MAX_AI_CONTEXT_CHARS=100000
CHUNK_WORDS=550
CHUNK_OVERLAP_WORDS=80
